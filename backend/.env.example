# Server Configuration
PORT=5000
NODE_ENV=development

# Demo Mode - when true, every OTP request/verify uses DEMO_OTP_CODE instead
# of dispatching real SMS. Use before a real SMS gateway is configured.
DEMO_MODE=false
DEMO_OTP_CODE=123456

# Database Connection
MONGODB_URI=mongodb://localhost:27017/agrawal_matrimony

# JWT Authentication
JWT_ACCESS_SECRET=your_super_secret_access_jwt_key
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_super_secret_refresh_jwt_key
JWT_REFRESH_EXPIRES_IN=7d
JWT_ADMIN_SECRET=your_super_secret_admin_jwt_key
JWT_ADMIN_EXPIRES_IN=24h

# OTP Settings
OTP_EXPIRY_SECONDS=300
OTP_COOLDOWN_SECONDS=30
OTP_MAX_ATTEMPTS=5
OTP_WINDOW_MINUTES=10

# Razorpay Payment Gateway
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# CORS
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# File Uploads
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=5

# SMS Gateway - REQUIRED in production, otherwise OTP login cannot work.
# Provider: msg91 | twilio | fast2sms | none (none = log to console, non-production only)
SMS_PROVIDER=none
SMS_SENDER_ID=AGRWLM
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
FAST2SMS_API_KEY=

# Email Gateway - provider: smtp | none
EMAIL_PROVIDER=none
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=Agrawal Matrimony <no-reply@agarwalbiodata.com>

# Firebase Cloud Messaging (web push) - optional. Set ONE of the two below;
# leave both blank to disable push (the in-app notification feed still works).
# Get the service account file from Firebase Console > Project Settings >
# Service Accounts > Generate new private key. Never commit this file.
FIREBASE_SERVICE_ACCOUNT_PATH=./config/firebase-service-account.json
FIREBASE_SERVICE_ACCOUNT_JSON=

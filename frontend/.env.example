# Backend API origin.
#
# Leave this EMPTY for local development - the Vite dev server proxies /api and
# /uploads to http://localhost:5000 (see vite.config.js).
#
# REQUIRED for production builds. The frontend and backend deploy separately, so
# without this every API call resolves against the static host and returns 404.
# Example: VITE_API_URL=https://api.agarwalbiodata.com
VITE_API_URL=

# Firebase Cloud Messaging (web push notifications). Get these from Firebase
# Console > Project Settings > General (the web app's config) and
# Project Settings > Cloud Messaging > Web Push certificates (VAPID key).
# These are public client identifiers, safe to expose in the frontend bundle.
# These same values are injected into the built service worker automatically
# by scripts/inject-sw-config.mjs during "npm run build" - do not edit
# public/firebase-messaging-sw.js by hand, it is a tracked template and any
# edit is reverted by the next deploy.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=
